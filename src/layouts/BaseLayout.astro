---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import T from '@/components/ui/T.astro';
import { DEFAULT_LOCALE, DIRECTIONS, LANG_BOOTSTRAP_SCRIPT, type Translations } from '@/lib/i18n';
import { THEME_BOOTSTRAP_SCRIPT } from '@/lib/theme';
import { withBase } from '@/lib/site';

interface Props {
  title: Translations;
  description: Translations;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// One inline script → one CSP hash. Must stay first in <head> to avoid a flash.
const bootstrapScript = THEME_BOOTSTRAP_SCRIPT + LANG_BOOTSTRAP_SCRIPT;

const preloadFonts = [
  'fonts/ibm-plex-sans-arabic-arabic-400-normal.woff2',
  'fonts/inter-latin-wght-normal.woff2',
];
---

<!doctype html>
<html lang={DEFAULT_LOCALE} dir={DIRECTIONS[DEFAULT_LOCALE]}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={bootstrapScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-title-ar={title.ar} data-title-en={title.en}>{title[DEFAULT_LOCALE]}</title>
    <meta name="description" content={description[DEFAULT_LOCALE]} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark light" />
    {preloadFonts.map((href) => (
      <link rel="preload" href={withBase(href)} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body class="flex min-h-screen flex-col bg-bg-primary text-text-primary antialiased">
    <a href="#main" class="skip-link">
      <T k="a11y.skipToContent" />
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/language-toggle';
    </script>
  </body>
</html>
