---
import { createHash } from 'node:crypto';
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import AmbientNetwork from '@/components/layout/AmbientNetwork.astro';
import T from '@/components/ui/T.astro';
import {
  DEFAULT_LOCALE,
  DIRECTIONS,
  LANG_BOOTSTRAP_SCRIPT,
  LOCALES,
  localizePath,
  stripBase,
  t,
  type Translations,
} from '@/lib/i18n';
import { THEME_BOOTSTRAP_SCRIPT } from '@/lib/theme';
import { pageLocale, withBase } from '@/lib/site';
import { OG_IMAGE, serializeJsonLd } from '@/lib/seo';

interface Props {
  title: Translations;
  description: Translations;
  noindex?: boolean;
  /** Open Graph type: 'website' for the home page, 'article' for case studies. */
  ogType?: 'website' | 'article';
  /** schema.org nodes for this page (rendered as one JSON-LD @graph). */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex = false, ogType = 'website', jsonLd = [] } = Astro.props;

// Absolute URLs from the configured site (astro.config.mjs).
const site = Astro.site ?? new URL('https://emadhassan-123.github.io');
const canonicalUrl = new URL(Astro.url.pathname, site).href;

// Each indexable page exists per language: '/path/' (Arabic) and '/en/path/' (English).
const locale = noindex ? DEFAULT_LOCALE : pageLocale(Astro.url);
const otherLocale = LOCALES.find((l) => l !== locale) ?? DEFAULT_LOCALE;
const neutralPath = stripBase(Astro.url.pathname, import.meta.env.BASE_URL);
const alternates = LOCALES.map((l) => ({
  hreflang: l,
  href: new URL(withBase(localizePath(neutralPath, l)), site).href,
}));
const OG_LOCALES = { ar: 'ar_AR', en: 'en_US' } as const;
const ogImageUrl = new URL(withBase(OG_IMAGE.path), site).href;

// One inline script → one CSP hash. Must stay first in <head> to avoid a flash.
const bootstrapScript = THEME_BOOTSTRAP_SCRIPT + LANG_BOOTSTRAP_SCRIPT;

/*
 * Content Security Policy (PHASE3_ARCH section 10.2), delivered as a meta tag
 * because GitHub Pages cannot set response headers. Production builds only:
 * the dev server injects inline scripts for hot reload.
 * - script-src: own files plus the single inline bootstrap, allowed by hash.
 *   JSON-LD and JSON data blocks are not executed, so CSP does not apply.
 * - connect-src: the contact Edge Function origin (and analytics, later).
 * frame-ancestors cannot be set from a meta tag, so it is not listed.
 */
const bootstrapHash = createHash('sha256').update(bootstrapScript).digest('base64');
const originOf = (url: string | undefined) => {
  try {
    return url ? new URL(url).origin : '';
  } catch {
    return '';
  }
};
const contactOrigin = originOf(import.meta.env.PUBLIC_CONTACT_FUNCTION_URL);
const csp = [
  "default-src 'self'",
  `script-src 'self' 'sha256-${bootstrapHash}'`,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  `connect-src 'self'${contactOrigin ? ` ${contactOrigin}` : ''}`,
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');

const preloadFonts = [
  'fonts/ibm-plex-sans-arabic-arabic-400-normal.woff2',
  'fonts/inter-latin-wght-normal.woff2',
];
---

<!doctype html>
<html lang={locale} dir={DIRECTIONS[locale]} data-localized={noindex ? undefined : ''}>
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <script is:inline set:html={bootstrapScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-title-ar={title.ar} data-title-en={title.en}>{title[locale]}</title>
    <meta name="description" content={description[locale]} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonicalUrl} />
        {alternates.map((a) => (
          <link rel="alternate" hreflang={a.hreflang} href={a.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
      </>
    )}

    <!-- Social sharing (Open Graph / Twitter) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t(locale, 'site.name')} />
    <meta property="og:title" content={title[locale]} />
    <meta property="og:description" content={description[locale]} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={title[locale]} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    <meta property="og:locale:alternate" content={OG_LOCALES[otherLocale]} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Icons and browser UI -->
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-48.png')} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#15171A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F2F3F1" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    {preloadFonts.map((href) => (
      <link rel="preload" href={withBase(href)} as="font" type="font/woff2" crossorigin />
    ))}
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col text-text-primary antialiased">
    <AmbientNetwork />
    <a href="#main" class="skip-link">
      <T k="a11y.skipToContent" />
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/language-toggle';
      import '@/scripts/ambient';
    </script>
  </body>
</html>
