---
/**
 * Contact station (PHASE2_IA section 5.7): direct channels beside the
 * contact form. The form posts to the contact-submit Edge Function when
 * PUBLIC_CONTACT_FUNCTION_URL is configured.
 */
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import T from '@/components/ui/T.astro';
import { CONTACT_LIMITS } from '@/lib/contact';
import { LOCALES, t, type TranslationKey } from '@/lib/i18n';
import { CONTACT, withBase } from '@/lib/site';

type Channel = {
  key: TranslationKey;
  href: string | null;
  value: string;
  icon: 'chat' | 'phone' | 'linkedin' | 'facebook' | 'mail';
  external?: boolean;
};

const channels: Channel[] = [
  {
    key: 'contact.channels.whatsapp',
    href: CONTACT.whatsappUrl,
    value: CONTACT.phoneDisplay,
    icon: 'chat',
    external: true,
  },
  {
    key: 'contact.channels.call',
    href: `tel:${CONTACT.phoneE164}`,
    value: CONTACT.phoneDisplay,
    icon: 'phone',
  },
  {
    key: 'contact.channels.linkedin',
    href: CONTACT.linkedinUrl,
    value: 'emad-hassan',
    icon: 'linkedin',
    external: true,
  },
  {
    key: 'contact.channels.facebook',
    href: CONTACT.facebookUrl,
    value: '',
    icon: 'facebook',
    external: true,
  },
  {
    key: 'contact.channels.email',
    href: CONTACT.email ? `mailto:${CONTACT.email}` : null,
    value: CONTACT.email ?? '',
    icon: 'mail',
  },
];

const icons: Record<Channel['icon'], IconName> = {
  chat: 'message-circle',
  phone: 'phone',
  linkedin: 'linkedin',
  facebook: 'facebook',
  mail: 'mail',
};

const fields = [
  { name: 'name', type: 'text', autocomplete: 'name', maxlength: CONTACT_LIMITS.name.max },
  { name: 'email', type: 'email', autocomplete: 'email', maxlength: CONTACT_LIMITS.email.max },
  { name: 'subject', type: 'text', autocomplete: 'off', maxlength: CONTACT_LIMITS.subject.max },
] as const;

// Client-side messages, embedded as an inert JSON data block (CSP-safe).
const messageKeys = [
  'errors.required',
  'errors.name',
  'errors.email',
  'errors.subject',
  'errors.message',
  'status.success',
  'status.invalid',
  'status.rateLimited',
  'status.failed',
  'status.notConnected',
  'submit',
  'sending',
] as const;
const clientMessages = Object.fromEntries(
  LOCALES.map((locale) => [
    locale,
    Object.fromEntries(messageKeys.map((k) => [k, t(locale, `contact.${k}` as TranslationKey)])),
  ]),
);
const endpoint = import.meta.env.PUBLIC_CONTACT_FUNCTION_URL ?? '';
---

<section id="contact" class="border-t border-border py-24">
  <div class="container">
    <SectionHeader title="sections.contact" icon="mail" pair="orange" />
    <p class="mt-3 max-w-prose text-lg text-text-secondary">
      <T k="contact.intro" />
    </p>

    <div class="contact-grid mt-12">
      <div>
        <h3 class="text-lg font-bold">
          <T k="contact.channelsTitle" />
        </h3>
        <ul class="contact-channels mt-5">
          {channels.map(({ key, href, value, icon, external }) => {
            const body = (
              <>
                <Icon name={icons[icon]} size={22} class="contact-channel__icon" />
                <span class="contact-channel__label">
                  <T k={key} />
                </span>
                <span class="contact-channel__value" dir="ltr" lang="en">
                  {href ? value : <T k="contact.channels.emailPending" />}
                </span>
              </>
            );
            return (
              <li>
                {href ? (
                  <a
                    href={href}
                    class="contact-channel"
                    {...(external ? { target: '_blank', rel: 'noopener' } : {})}
                  >
                    {body}
                    {external && (
                      <span class="sr-only">
                        <T k="contact.newTab" />
                      </span>
                    )}
                  </a>
                ) : (
                  <span
                    class="contact-channel todo-placeholder"
                    aria-disabled="true"
                    title="TODO: contact-email"
                  >
                    {body}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-bold">
          <T k="contact.formTitle" />
        </h3>
        <form class="contact-form mt-5" novalidate data-contact-form data-endpoint={endpoint}>
          {fields.map(({ name, type, autocomplete, maxlength }) => (
            <div class="form-field">
              <label for={`contact-${name}`}>
                <T k={`contact.fields.${name}`} />
              </label>
              <input
                id={`contact-${name}`}
                name={name}
                type={type}
                autocomplete={autocomplete}
                maxlength={maxlength}
                required
                aria-describedby={`contact-${name}-error`}
                dir={type === 'email' ? 'ltr' : 'auto'}
              />
              <p id={`contact-${name}-error`} class="form-field__error" data-error-for={name} />
            </div>
          ))}
          <div class="form-field">
            <label for="contact-message">
              <T k="contact.fields.message" />
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              maxlength={CONTACT_LIMITS.message.max}
              required
              aria-describedby="contact-message-error"
              dir="auto"
            ></textarea>
            <p id="contact-message-error" class="form-field__error" data-error-for="message"></p>
          </div>

          <!-- Honeypot: hidden from people, filled by naive bots. -->
          <div class="form-honeypot" aria-hidden="true">
            <label for="contact-website">
              <T k="contact.fields.honeypot" />
            </label>
            <input
              id="contact-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="mt-2 flex flex-wrap items-center gap-4">
            <button type="submit" class="btn-primary" data-submit>
              <T k="contact.submit" />
            </button>
          </div>
          <p class="form-status" role="status" aria-live="polite" data-form-status></p>
          <p class="mt-4 text-sm text-text-muted">
            <T k="contact.privacy" />
            <a href={withBase('/privacy/')} class="nav-link">
              <T k="contact.privacyLink" />
            </a>
          </p>
        </form>
        <script
          type="application/json"
          id="contact-messages"
          set:html={JSON.stringify(clientMessages)}
        />
      </div>
    </div>
  </div>
</section>

<script>
  import '@/scripts/contact-form';
</script>
