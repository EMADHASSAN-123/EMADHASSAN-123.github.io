---
/**
 * Hero station — a cloud-console style profile (owner-approved, 17 Nov 2026).
 * An original console layout (not a copy of any provider's UI) filled only
 * with documented facts: identity, education, languages, the three areas of
 * work as "services", and the four projects as "resources" with their real
 * statuses. No invented metrics. The sidebar is real in-page navigation.
 */
import { Picture } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import T from '@/components/ui/T.astro';
import profile from '@/assets/images/profile.jpg';
import { i18nAttrs, t, type TranslationKey } from '@/lib/i18n';
import { withBase } from '@/lib/site';

type ProjectData = CollectionEntry<'projects'>['data'];

const sections: { id: string; key: TranslationKey; icon: IconName }[] = [
  { id: 'hero', key: 'console.profile', icon: 'user' },
  { id: 'methodology', key: 'sections.methodology', icon: 'workflow' },
  { id: 'expertise', key: 'sections.expertise', icon: 'layers' },
  { id: 'projects', key: 'sections.projects', icon: 'boxes' },
  { id: 'certifications', key: 'sections.certifications', icon: 'award' },
  { id: 'contact', key: 'sections.contact', icon: 'mail' },
];

const services = [
  { id: 'software', pair: 'blue', icon: 'code-xml' },
  { id: 'data', pair: 'orange', icon: 'brain-circuit' },
  { id: 'databases', pair: 'green', icon: 'database' },
] as const;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const led: Record<ProjectData['status'], string> = {
  implemented: 'up',
  live: 'up',
  prototype: 'staging',
  'in-analysis': 'provisioning',
};
---

<section id="hero" class="hero-console" data-console>
  <div class="container py-12 lg:py-16">
    <div class="console">
      <div class="console__bar">
        <span class="console__dots" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <p class="console__crumb" dir="ltr" lang="en">
          <span>emadhassan-123</span>
          <span aria-hidden="true">/</span>
          <span data-lang="en">profile</span>
          <span data-lang="ar">الملف الشخصي</span>
        </p>
      </div>

      <div class="console__body">
        <nav class="console__side" {...i18nAttrs({ 'aria-label': 'console.sidebarLabel' })}>
          <ul>
            {sections.map(({ id, key, icon }, index) => (
              <li>
                <a
                  href={withBase(`/#${id}`)}
                  class:list={['console__link', { 'is-current': index === 0 }]}
                >
                  <Icon name={icon} size={16} />
                  <T k={key} />
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="console__main">
          <header class="instance">
            <div class="instance__photo">
              <Picture
                src={profile}
                widths={[200, 300, 400]}
                sizes="(min-width: 1024px) 9rem, 6.5rem"
                formats={['webp']}
                fallbackFormat="jpg"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="block aspect-[3/4] h-full w-full object-cover"
                {...i18nAttrs({ alt: 'hero.photoAlt' })}
                alt={t('ar', 'hero.photoAlt')}
              />
            </div>
            <div class="min-w-0">
              <h1 class="instance__name">
                <T k="site.name" />
              </h1>
              <p class="instance__role">
                <T k="hero.role" />
              </p>
            </div>
          </header>

          <p class="instance__personal">
            <T k="hero.personal" />
          </p>

          <dl class="instance__facts">
            <div>
              <dt>
                <Icon name="map-pin" size={14} />
                <T k="console.fields.location" />
              </dt>
              <dd>
                <T k="hero.card.location" />
              </dd>
            </div>
            <div>
              <dt>
                <Icon name="graduation-cap" size={14} />
                <T k="console.fields.education" />
              </dt>
              <dd>
                <T k="hero.card.degree" />{' '}
                <span class="text-text-muted">
                  <T k="hero.card.university" />
                </span>
              </dd>
            </div>
            <div>
              <dt>
                <Icon name="languages" size={14} />
                <T k="console.fields.languages" />
              </dt>
              <dd>
                <T k="console.languages" />
              </dd>
            </div>
          </dl>

          <div class="console__panels">
            <section class="panel" aria-labelledby="console-services">
              <h2 id="console-services" class="panel__title">
                <T k="console.servicesTitle" />
              </h2>
              <ul class="services">
                {services.map(({ id, pair, icon }) => (
                  <li class="service" data-pair={pair}>
                    <p class="service__name">
                      <Icon name={icon} size={18} />
                      <T k={`hero.domains.${id}.name` as TranslationKey} />
                    </p>
                    <p class="service__text">
                      <T k={`hero.domains.${id}.text` as TranslationKey} />
                    </p>
                  </li>
                ))}
              </ul>
            </section>

            <section class="panel" aria-labelledby="console-resources">
              <h2 id="console-resources" class="panel__title">
                <T k="console.resourcesTitle" />
              </h2>
              <table class="resources">
                <thead>
                  <tr>
                    <th scope="col">
                      <T k="console.resource" />
                    </th>
                    <th scope="col">
                      <T k="console.status" />
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {projects.map(({ id, data }) => (
                    <tr>
                      <td>
                        <a
                          href={withBase(`/projects/${id}/`)}
                          class="resources__link"
                          lang="en"
                          dir="ltr"
                        >
                          {data.shortName}
                        </a>
                      </td>
                      <td>
                        <span class="resources__status" data-led={led[data.status]}>
                          <span class="resources__led" aria-hidden="true" />
                          <T k={`projects.status.${data.status}` as TranslationKey} />
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          </div>

          <div class="console__actions">
            <a href={withBase('/#projects')} class="btn-primary">
              <T k="hero.ctaProjects" />
            </a>
            <a href={withBase('/#contact')} class="btn-outline btn-lg">
              <T k="hero.ctaContact" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
