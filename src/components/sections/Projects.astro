---
/**
 * Projects preview station (PHASE2_IA section 5.5). Display order 1 → 3 → 2 → 4
 * comes from the `order` field. Project 1 is featured with a simplified
 * architecture sketch limited to documented facts (PROJECT_CONTEXT 5.2;
 * preprocessing and inference in the Flutter app, SQLite on the phone, per owner).
 */
import { getCollection } from 'astro:content';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import T from '@/components/ui/T.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = projects;
---

<section id="projects" class="border-t border-border py-24">
  <div class="container">
    <SectionHeader title="sections.projects" icon="boxes" pair="green" />
    <p class="mt-3 max-w-prose text-lg text-text-secondary">
      <T k="projects.intro" />
    </p>

    <div class="projects-grid mt-12">
      {featured && (
        <ProjectCard project={featured} featured>
          <svg slot="visual" class="arch-sketch" viewBox="0 0 440 220" role="presentation">
            <defs>
              <marker
                id="arch-arrow"
                viewBox="0 0 8 8"
                refX="7"
                refY="4"
                markerWidth="7"
                markerHeight="7"
                orient="auto"
              >
                <path d="M0 0 8 4 0 8Z" class="arch-sketch__arrowhead" />
              </marker>
            </defs>

            <!-- Device: sensor to microcontroller to phone app -->
            <g class="arch-sketch__row">
              <rect x="4" y="30" width="112" height="44" rx="4" />
              <text x="60" y="57">
                AS7265X
              </text>
              <rect x="164" y="30" width="112" height="44" rx="4" />
              <text x="220" y="57">
                ESP32
              </text>
              <rect x="324" y="30" width="112" height="44" rx="4" />
              <text x="380" y="57">
                Flutter App
              </text>
            </g>
            <g class="arch-sketch__links">
              <line x1="116" y1="52" x2="162" y2="52" marker-end="url(#arch-arrow)" />
              <line x1="276" y1="52" x2="322" y2="52" marker-end="url(#arch-arrow)" />
              <path d="M380 74V94H76V138" marker-end="url(#arch-arrow)" />
            </g>
            <g class="arch-sketch__labels">
              <text x="140" y="22">
                I²C
              </text>
              <text x="300" y="22">
                BLE
              </text>
            </g>

            <!-- On the phone: preprocessing, on-device classification, local storage -->
            <rect class="arch-sketch__group" x="4" y="110" width="432" height="104" rx="6" />
            <text x="424" y="128" class="arch-sketch__caption arch-sketch__caption--end">
              On the phone
            </text>
            <g class="arch-sketch__row arch-sketch__row--data">
              <rect x="16" y="140" width="120" height="44" rx="4" />
              <text x="76" y="167">
                Preprocessing
              </text>
              <rect x="160" y="140" width="120" height="44" rx="4" />
              <text x="220" y="167">
                TFLite model
              </text>
              <rect x="304" y="140" width="120" height="44" rx="4" />
              <text x="364" y="167">
                SQLite
              </text>
            </g>
            <g class="arch-sketch__links">
              <line x1="136" y1="162" x2="158" y2="162" marker-end="url(#arch-arrow)" />
              <line x1="280" y1="162" x2="302" y2="162" marker-end="url(#arch-arrow)" />
            </g>
            <g class="arch-sketch__labels">
              <text x="292" y="202">
                results
              </text>
            </g>
          </svg>
        </ProjectCard>
      )}
      {rest.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>
