---
/**
 * Expertise station — evidence board, two parts (owner-approved, 17 Nov 2026):
 * 1. Technical skills grouped by the SFIA 9 framework (group headings cite the
 *    SFIA 9 skills they map to).
 * 2. Professional and personal skills grouped by the core-skill families of
 *    the WEF Future of Jobs Report 2025.
 * Skill names use market-standard terms; every skill carries evidence from
 * documented work (PROJECT_CONTEXT sections 4, 5 and 4.4). No proficiency
 * levels are shown (no formal assessment exists). Academic and learning areas
 * stay visibly separate (CLAUDE.md section 2).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import T from '@/components/ui/T.astro';
import { t, type TranslationKey } from '@/lib/i18n';
import { withBase } from '@/lib/site';

type ProjectId = CollectionEntry<'projects'>['id'];
type Pair = 'blue' | 'orange' | 'green' | 'brown' | 'white';
type Evidence =
  { project: ProjectId; item: string } | { href: string; label: string; item: string };
interface Skill {
  id: string;
  stack?: string[];
  evidence: Evidence[];
}
interface Group {
  id: string;
  pair: Pair;
  icon: IconName;
  framework?: string;
  skills: Skill[];
}

const technical: Group[] = [
  {
    id: 'dev',
    pair: 'blue',
    icon: 'code-xml',
    framework: 'SFIA 9: Programming/software development, Software design',
    skills: [
      {
        id: 'web',
        stack: ['HTML5', 'CSS3', 'Tailwind CSS', 'JavaScript'],
        evidence: [
          { project: 'alshifa-quran-website', item: 'web_shifa' },
          { project: 'content-management-blog', item: 'web_cms' },
        ],
      },
      {
        id: 'mobile',
        stack: ['Flutter', 'Dart'],
        evidence: [{ project: 'fuel-quality-detection', item: 'mobile_fuel' }],
      },
      {
        id: 'backendfeat',
        stack: ['Supabase', 'JavaScript'],
        evidence: [{ project: 'content-management-blog', item: 'auth_cms' }],
      },
    ],
  },
  {
    id: 'dataai',
    pair: 'orange',
    icon: 'brain-circuit',
    framework: 'SFIA 9: Data science, Machine learning, Data visualisation',
    skills: [
      {
        id: 'dataprep',
        stack: ['Python', 'Jupyter'],
        evidence: [{ project: 'fuel-quality-detection', item: 'data_fuel' }],
      },
      {
        id: 'ml',
        stack: ['Scikit-learn', 'TensorFlow Lite'],
        evidence: [{ project: 'fuel-quality-detection', item: 'model_fuel' }],
      },
      {
        id: 'viz',
        stack: ['JavaScript'],
        evidence: [{ project: 'content-management-blog', item: 'viz_cms' }],
      },
    ],
  },
  {
    id: 'datamgmt',
    pair: 'green',
    icon: 'database',
    framework: 'SFIA 9: Database design, Data modelling and design',
    skills: [
      {
        id: 'dbdesign',
        stack: ['Supabase', 'PostgreSQL'],
        evidence: [
          { project: 'content-management-blog', item: 'db_cms' },
          { project: 'alshifa-quran-website', item: 'db_shifa' },
        ],
      },
      {
        id: 'localdata',
        stack: ['SQLite'],
        evidence: [{ project: 'fuel-quality-detection', item: 'db_fuel' }],
      },
      { id: 'modeling', evidence: [{ project: 'alshifa-management-system', item: 'db_mis' }] },
    ],
  },
  {
    id: 'analysis',
    pair: 'white',
    icon: 'compass',
    framework: 'SFIA 9: Requirements definition and management, Systems design',
    skills: [
      {
        id: 'requirements',
        evidence: [
          { project: 'alshifa-quran-website', item: 'design_shifa' },
          { project: 'content-management-blog', item: 'design_cms' },
          { project: 'alshifa-management-system', item: 'design_mis' },
        ],
      },
      { id: 'sysdesign', evidence: [{ project: 'fuel-quality-detection', item: 'arch_fuel' }] },
    ],
  },
  {
    id: 'embedded',
    pair: 'brown',
    icon: 'cpu',
    skills: [
      {
        id: 'iot',
        stack: ['ESP32', 'AS7265X', 'I²C', 'BLE', 'Edge AI', 'Arduino IDE'],
        evidence: [{ project: 'fuel-quality-detection', item: 'iot_fuel' }],
      },
    ],
  },
];

const certs = withBase('/#certifications');
const professional: Group[] = [
  {
    id: 'cognitive',
    pair: 'orange',
    icon: 'lightbulb',
    skills: [
      {
        id: 'analytical',
        evidence: [
          { project: 'fuel-quality-detection', item: 'analytical_fuel' },
          { project: 'alshifa-management-system', item: 'analytical_mis' },
        ],
      },
      {
        id: 'learning',
        evidence: [
          { href: certs, label: 'certAi', item: 'learning_ai' },
          { href: certs, label: 'certWs', item: 'learning_ws' },
        ],
      },
    ],
  },
  {
    id: 'selfmgmt',
    pair: 'green',
    icon: 'shield-check',
    skills: [
      {
        id: 'flexibility',
        evidence: [{ href: withBase('/#projects'), label: 'portfolio', item: 'flex_domains' }],
      },
      { id: 'ownership', evidence: [{ project: 'alshifa-quran-website', item: 'own_shifa' }] },
    ],
  },
  {
    id: 'others',
    pair: 'blue',
    icon: 'message-circle',
    skills: [
      { id: 'communication', evidence: [{ project: 'alshifa-quran-website', item: 'comm_shifa' }] },
      { id: 'presenting', evidence: [{ href: certs, label: 'certGmai', item: 'present_gmai' }] },
      {
        id: 'documentation',
        evidence: [
          { project: 'content-management-blog', item: 'doc_cms' },
          { project: 'alshifa-management-system', item: 'doc_mis' },
        ],
      },
    ],
  },
];

const tools = ['Git', 'GitHub', 'Jupyter', 'Anaconda', 'Google Workspace', 'Microsoft Office'];

// PROJECT_CONTEXT 4.2 and 4.3 — names only, clearly separated from applied work.
const academic: TranslationKey[] = [
  'expertise.groups.networking',
  'expertise.groups.security',
  'expertise.groups.backend',
  'expertise.groups.sdlc',
];
const learning: TranslationKey[] = [
  'expertise.groups.aiEngineering',
  'expertise.groups.agents',
  'expertise.groups.aiops',
  'expertise.groups.architecture',
  'expertise.groups.cloud',
];

const projects = new Map((await getCollection('projects')).map((p) => [p.id, p.data]));
const k = (path: string) => path as TranslationKey;
const parts = [
  { id: 'tech', title: 'expertise.partTech', note: 'expertise.frameworkTech', groups: technical },
  {
    id: 'soft',
    title: 'expertise.partSoft',
    note: 'expertise.frameworkSoft',
    groups: professional,
  },
] as const;
---

<section id="expertise" class="border-t border-border py-24">
  <div class="container">
    <SectionHeader title="sections.expertise" icon="layers" pair="orange" />
    <p class="mt-3 max-w-prose text-lg text-text-secondary">
      <T k="expertise.intro" />
    </p>

    {parts.map((part) => (
      <div class="board-part" aria-labelledby={`part-${part.id}`}>
        <h3 id={`part-${part.id}`} class="board-part__title">
          <T k={part.title} />
        </h3>
        <p class="board-part__note">
          <T k={part.note} />
        </p>

        <div class="board">
          {part.groups.map(({ id, pair, icon, framework, skills }) => (
            <section class="board__group" data-pair={pair} aria-labelledby={`skills-${id}`}>
              <div class="board__head">
                <h4 id={`skills-${id}`} class="board__title">
                  <Icon name={icon} size={22} />
                  <T k={k(`expertise.groupsV2.${id}`)} />
                </h4>
                {framework && (
                  <p class="board__framework" lang="en" dir="ltr">
                    {framework}
                  </p>
                )}
                <div class="twist" aria-hidden="true" />
              </div>

              <ul class="board__skills">
                {skills.map((skill) => (
                  <li class="skill">
                    <div class="skill__label">
                      <h5 class="skill__name">
                        <T k={k(`expertise.skillsV2.${skill.id}`)} />
                      </h5>
                      <p class="skill__std" data-lang="ar" lang="en" dir="ltr">
                        {t('en', k(`expertise.skillsStd.${skill.id}`))}
                      </p>
                      {skill.stack && (
                        <p class="skill__stack" lang="en" dir="ltr">
                          {skill.stack.join(' / ')}
                        </p>
                      )}
                    </div>
                    <ul class="skill__evidence">
                      {skill.evidence.map((ev) => {
                        if ('project' in ev) {
                          const project = projects.get(ev.project);
                          if (!project) throw new Error(`Unknown project "${ev.project}"`);
                          return (
                            <li class="evidence">
                              <a
                                href={withBase(`/projects/${ev.project}/`)}
                                class:list={[
                                  'evidence__project',
                                  { 'evidence__project--design': project.status === 'in-analysis' },
                                ]}
                                lang="en"
                                dir="ltr"
                              >
                                {project.shortName}
                              </a>
                              <p class="evidence__text">
                                <T k={k(`expertise.evidenceItems.${ev.item}`)} />
                              </p>
                            </li>
                          );
                        }
                        return (
                          <li class="evidence">
                            <a href={ev.href} class="evidence__project">
                              <T k={k(`expertise.evidenceLinks.${ev.label}`)} />
                            </a>
                            <p class="evidence__text">
                              <T k={k(`expertise.evidenceItems.${ev.item}`)} />
                            </p>
                          </li>
                        );
                      })}
                    </ul>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    ))}

    <p class="board__tools">
      <span class="text-text-muted">
        <T k="expertise.toolsLabel" />:
      </span>
      <span lang="en" dir="ltr">
        {tools.join(' / ')}
      </span>
    </p>

    <div class="beyond">
      <h3 class="beyond__title">
        <T k="expertise.otherTitle" />
      </h3>
      <dl class="beyond__rows">
        <div class="beyond__row" data-tier="academic">
          <dt>
            <span class="skill-node" aria-hidden="true"></span>
            <T k="expertise.tiers.academic.title" />
          </dt>
          <dd>
            <ul class="beyond__list">
              {academic.map((key) => (
                <li>
                  <T k={key} />
                </li>
              ))}
            </ul>
            <p class="beyond__note">
              <T k="expertise.tiers.academic.description" />
            </p>
          </dd>
        </div>
        <div class="beyond__row" data-tier="learning">
          <dt>
            <span class="skill-node" aria-hidden="true"></span>
            <T k="expertise.tiers.learning.title" />
          </dt>
          <dd>
            <ul class="beyond__list">
              {learning.map((key) => (
                <li>
                  <T k={key} />
                </li>
              ))}
            </ul>
            <p class="beyond__note">
              <T k="expertise.tiers.learning.description" />
            </p>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
