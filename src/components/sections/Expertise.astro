---
/**
 * Expertise station — evidence board (owner-approved redesign, 17 Nov 2026).
 * Each applied skill shows where it was applied and what was actually done,
 * using the documented contributions (PROJECT_CONTEXT sections 4.1 and 5).
 * Academic knowledge (4.2) and learning (4.3) stay visibly separate, in a
 * compact strip, as required by CLAUDE.md section 2.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import T from '@/components/ui/T.astro';
import type { TranslationKey } from '@/lib/i18n';
import { withBase } from '@/lib/site';

type ProjectId = CollectionEntry<'projects'>['id'];
type Pair = 'blue' | 'orange' | 'green' | 'brown' | 'white';
interface Evidence {
  project: ProjectId;
  item: string;
}
interface Skill {
  id: string;
  stack: string[];
  evidence: Evidence[];
}

const groups: { id: string; pair: Pair; skills: Skill[] }[] = [
  {
    id: 'software',
    pair: 'blue',
    skills: [
      {
        id: 'frontend',
        stack: ['HTML5', 'CSS3', 'Tailwind CSS', 'JavaScript'],
        evidence: [
          { project: 'alshifa-quran-website', item: 'web_shifa' },
          { project: 'content-management-blog', item: 'web_cms' },
        ],
      },
      {
        id: 'mobile',
        stack: ['Flutter', 'Dart'],
        evidence: [{ project: 'fuel-quality-detection', item: 'mobile_fuel' }],
      },
      {
        id: 'auth',
        stack: ['Supabase', 'JavaScript'],
        evidence: [{ project: 'content-management-blog', item: 'auth_cms' }],
      },
    ],
  },
  {
    id: 'data',
    pair: 'orange',
    skills: [
      {
        id: 'dataprep',
        stack: ['Python', 'Jupyter'],
        evidence: [{ project: 'fuel-quality-detection', item: 'data_fuel' }],
      },
      {
        id: 'models',
        stack: ['Scikit-learn', 'TensorFlow Lite'],
        evidence: [{ project: 'fuel-quality-detection', item: 'model_fuel' }],
      },
      {
        id: 'viz',
        stack: ['JavaScript'],
        evidence: [{ project: 'content-management-blog', item: 'viz_cms' }],
      },
    ],
  },
  {
    id: 'databases',
    pair: 'green',
    skills: [
      {
        id: 'supabase',
        stack: ['Supabase', 'PostgreSQL'],
        evidence: [
          { project: 'content-management-blog', item: 'db_cms' },
          { project: 'alshifa-quran-website', item: 'db_shifa' },
        ],
      },
      {
        id: 'sqlite',
        stack: ['SQLite'],
        evidence: [{ project: 'fuel-quality-detection', item: 'db_fuel' }],
      },
      {
        id: 'modeling',
        stack: ['Database Design', 'Data Modeling'],
        evidence: [{ project: 'alshifa-management-system', item: 'db_mis' }],
      },
    ],
  },
  {
    id: 'embedded',
    pair: 'brown',
    skills: [
      {
        id: 'iot',
        stack: ['ESP32', 'AS7265X', 'I²C', 'BLE', 'Edge AI', 'Arduino IDE'],
        evidence: [{ project: 'fuel-quality-detection', item: 'iot_fuel' }],
      },
    ],
  },
  {
    id: 'design',
    pair: 'white',
    skills: [
      {
        id: 'analysis',
        stack: ['Requirements Analysis', 'System Design'],
        evidence: [
          { project: 'fuel-quality-detection', item: 'design_fuel' },
          { project: 'alshifa-quran-website', item: 'design_shifa' },
          { project: 'content-management-blog', item: 'design_cms' },
          { project: 'alshifa-management-system', item: 'design_mis' },
        ],
      },
    ],
  },
];

const tools = ['Git', 'GitHub', 'Jupyter', 'Anaconda', 'Google Workspace', 'Microsoft Office'];

// PROJECT_CONTEXT 4.2 and 4.3 — names only, clearly separated from applied work.
const academic: TranslationKey[] = [
  'expertise.groups.networking',
  'expertise.groups.security',
  'expertise.groups.backend',
  'expertise.groups.sdlc',
];
const learning: TranslationKey[] = [
  'expertise.groups.aiEngineering',
  'expertise.groups.agents',
  'expertise.groups.aiops',
  'expertise.groups.architecture',
  'expertise.groups.cloud',
];

const projects = new Map((await getCollection('projects')).map((p) => [p.id, p.data]));
const k = (path: string) => path as TranslationKey;
---

<section id="expertise" class="border-t border-border py-24">
  <div class="container">
    <h2 class="text-3xl font-bold">
      <T k="sections.expertise" />
    </h2>
    <p class="mt-3 max-w-prose text-lg text-text-secondary">
      <T k="expertise.intro" />
    </p>

    <div class="board">
      {groups.map(({ id, pair, skills }) => (
        <section class="board__group" data-pair={pair} aria-labelledby={`skills-${id}`}>
          <div class="board__head">
            <h3 id={`skills-${id}`} class="board__title">
              <T k={k(`expertise.groupsApplied.${id}`)} />
            </h3>
            <div class="twist" aria-hidden="true" />
          </div>

          <ul class="board__skills">
            {skills.map((skill) => (
              <li class="skill">
                <div class="skill__label">
                  <h4 class="skill__name">
                    <T k={k(`expertise.skills.${skill.id}`)} />
                  </h4>
                  <p class="skill__stack" lang="en" dir="ltr">
                    {skill.stack.join(' / ')}
                  </p>
                </div>
                <ul class="skill__evidence">
                  {skill.evidence.map(({ project: pid, item }) => {
                    const project = projects.get(pid);
                    if (!project) throw new Error(`Unknown project "${pid}"`);
                    return (
                      <li class="evidence">
                        <a
                          href={withBase(`/projects/${pid}/`)}
                          class:list={[
                            'evidence__project',
                            { 'evidence__project--design': project.status === 'in-analysis' },
                          ]}
                          lang="en"
                          dir="ltr"
                        >
                          {project.shortName}
                        </a>
                        <p class="evidence__text">
                          <T k={k(`expertise.evidenceItems.${item}`)} />
                        </p>
                      </li>
                    );
                  })}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="board__tools">
      <span class="text-text-muted">
        <T k="expertise.toolsLabel" />:
      </span>
      <span lang="en" dir="ltr">
        {tools.join(' / ')}
      </span>
    </p>

    <div class="beyond">
      <h3 class="beyond__title">
        <T k="expertise.otherTitle" />
      </h3>
      <dl class="beyond__rows">
        <div class="beyond__row" data-tier="academic">
          <dt>
            <span class="skill-node" aria-hidden="true"></span>
            <T k="expertise.tiers.academic.title" />
          </dt>
          <dd>
            <ul class="beyond__list">
              {academic.map((key) => (
                <li>
                  <T k={key} />
                </li>
              ))}
            </ul>
            <p class="beyond__note">
              <T k="expertise.tiers.academic.description" />
            </p>
          </dd>
        </div>
        <div class="beyond__row" data-tier="learning">
          <dt>
            <span class="skill-node" aria-hidden="true"></span>
            <T k="expertise.tiers.learning.title" />
          </dt>
          <dd>
            <ul class="beyond__list">
              {learning.map((key) => (
                <li>
                  <T k={key} />
                </li>
              ))}
            </ul>
            <p class="beyond__note">
              <T k="expertise.tiers.learning.description" />
            </p>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
