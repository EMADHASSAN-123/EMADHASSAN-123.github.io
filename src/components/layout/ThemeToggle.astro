---
/**
 * Cycles Auto → Dark → Light. The visible icon follows
 * <html data-theme-preference>, which is set before first paint.
 */
import { statefulLabelAttrs } from '@/lib/i18n';

const labels = statefulLabelAttrs(
  { auto: 'toggles.theme.auto', dark: 'toggles.theme.dark', light: 'toggles.theme.light' },
  'auto',
  ['aria-label', 'title'],
);
---

<button type="button" class="icon-button" data-theme-toggle data-requires-js {...labels}>
  <svg
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <g data-theme-icon="auto">
      <circle cx="12" cy="12" r="8"></circle>
      <circle cx="12" cy="12" r="2.25" fill="currentColor" stroke="none"></circle>
    </g>
    <g data-theme-icon="dark">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
    </g>
    <g data-theme-icon="light">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
    </g>
  </svg>
</button>

<script>
  import '@/scripts/theme-toggle';
</script>
