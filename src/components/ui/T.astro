---
/**
 * Renders a translation in every locale; CSS shows only the active one.
 */
import { LOCALES, t, type TranslationKey } from '@/lib/i18n';

interface Props {
  k: TranslationKey;
}

const { k } = Astro.props;
const ARABIC = /[\u0600-\u06FF]/;
---

{LOCALES.map((locale) => {
  const value = t(locale, k);
  // Technical terms and proper names stay in English in the Arabic version
  // (PHASE2_IA 10.1): mark them as English so screen readers pronounce them correctly.
  const lang = locale === 'ar' && !ARABIC.test(value) ? 'en' : locale;
  return (
    <span data-lang={locale} lang={lang}>
      {value}
    </span>
  );
})}
