---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Methodology from '@/components/sections/Methodology.astro';
import Expertise from '@/components/sections/Expertise.astro';
import Projects from '@/components/sections/Projects.astro';
import Certifications from '@/components/sections/Certifications.astro';
import Interests from '@/components/sections/Interests.astro';
import Contact from '@/components/sections/Contact.astro';
import { translations } from '@/lib/i18n';
import { personJsonLd, websiteJsonLd } from '@/lib/seo';
import profile from '@/assets/images/profile.jpg';

const site = Astro.site ?? new URL('https://emadhassan-123.github.io');
const jsonLd = [personJsonLd(site, new URL(profile.src, site).href), websiteJsonLd(site)];
---

<BaseLayout
  title={translations('meta.homeTitle')}
  description={translations('meta.description')}
  jsonLd={jsonLd}
>
  <Hero />
  <Methodology />
  <Expertise />
  <Projects />
  <Certifications />
  <Interests />
  <Contact />
</BaseLayout>
