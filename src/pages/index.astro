---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Methodology from '@/components/sections/Methodology.astro';
import Expertise from '@/components/sections/Expertise.astro';
import Projects from '@/components/sections/Projects.astro';
import Certifications from '@/components/sections/Certifications.astro';
import Interests from '@/components/sections/Interests.astro';
import Contact from '@/components/sections/Contact.astro';
import { translations } from '@/lib/i18n';
---

<BaseLayout
  title={translations('meta.homeTitle')}
  description={translations('meta.description')}
  noindex
>
  <Hero />
  <Methodology />
  <Expertise />
  <Projects />
  <Certifications />
  <Interests />
  <Contact />
</BaseLayout>
