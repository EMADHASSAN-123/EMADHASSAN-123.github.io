---
/**
 * Case study — Project 4 (PROJECT_CONTEXT section 5.5): under study,
 * analysis and design. Every module is drawn as proposed; the stack is
 * not decided yet.
 */
import { localeStaticPaths } from '@/lib/locale-paths';
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import InteractiveDiagram from '@/components/projects/InteractiveDiagram.astro';
import T from '@/components/ui/T.astro';
import diagramSvg from '@/assets/diagrams/alshifa-mis.svg?raw';
import type { TranslationKey } from '@/lib/i18n';

export const getStaticPaths = localeStaticPaths;

const id = 'alshifa-management-system';
const k = (path: string) => `caseStudies.${id}.${path}` as TranslationKey;
const node = (nodeId: string, name: string) => ({
  id: nodeId,
  name,
  description: k(`nodes.${nodeId}`),
});
const nodes = [
  node('branches', 'Branches'),
  node('circles', 'Study circles'),
  node('students', 'Students'),
  node('teachers', 'Teachers'),
  node('staff', 'Supervisors & staff'),
  node('attendance', 'Attendance'),
  node('transfers', 'Student transfers'),
  node('memorization', 'Memorization completion'),
  node('salaries', 'Monthly salaries'),
  node('expenses', 'Needs & expenses'),
  node('reports', 'Reports & statistics'),
  node('roles', 'Roles & permissions'),
];
const contribution = Array.from({ length: 2 }, (_, i) =>
  k(`contribution.c${String(i + 1).padStart(2, '0')}`),
);
---

<ProjectLayout id={id}>
  <section class="case-section container" aria-labelledby="cs-problem">
    <h2 id="cs-problem" class="case-section__title">
      <T k="caseStudy.problem" />
    </h2>
    <p class="max-w-prose text-lg">
      <T k={k('problem1')} />
    </p>
    <p class="mt-4 max-w-prose text-text-secondary">
      <T k={k('problem2')} />
    </p>
  </section>

  <section class="case-section container" aria-labelledby="cs-architecture">
    <h2 id="cs-architecture" class="case-section__title">
      <T k="caseStudy.architecture" />
    </h2>
    <InteractiveDiagram svg={diagramSvg} nodes={nodes} hint={k('diagramHint')} />
  </section>

  <section class="case-section container" aria-labelledby="cs-contribution">
    <h2 id="cs-contribution" class="case-section__title">
      <T k="caseStudy.contribution" />
    </h2>
    <ul class="contribution-list">
      {contribution.map((c) => (
        <li>
          <T k={c} />
        </li>
      ))}
    </ul>
  </section>

  <section class="case-section container" aria-labelledby="cs-stack">
    <h2 id="cs-stack" class="case-section__title">
      <T k="caseStudy.stack" />
    </h2>
    <p class="text-text-secondary">
      <T k="projects.stackPending" />
    </p>
  </section>

  <section class="case-section container" aria-labelledby="cs-status">
    <h2 id="cs-status" class="case-section__title">
      <T k="caseStudy.status" />
    </h2>
    <p class="case-callout case-callout--warning">
      <T k={k('status')} />
    </p>
    <p class="mt-4 max-w-prose">
      <T k={k('next')} />
    </p>
  </section>
</ProjectLayout>
