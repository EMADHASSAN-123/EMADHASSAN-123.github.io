# Copy to .env and fill in real values locally. Never commit .env.
# Every PUBLIC_* variable is embedded in the client bundle: never put secrets here.
# Server-only secrets (service role key, IP hash salt) live exclusively in the
# Supabase Edge Function environment and must not appear in this file.

# ===== Public (client-exposed) =====
PUBLIC_SITE_URL=https://<username>.github.io
PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Not required by the contact form (its Edge Function needs no JWT).
PUBLIC_SUPABASE_ANON_KEY=<anon_key>
PUBLIC_CONTACT_FUNCTION_URL=https://<project>.supabase.co/functions/v1/contact-submit
PUBLIC_UMAMI_URL=https://umami.<username>.vercel.app
PUBLIC_UMAMI_SITE_ID=<site_id>
